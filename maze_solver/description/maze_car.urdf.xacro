<?xml version="1.0"?>
<!-- maze_car - the same differential-drive rover as obstacle_rover,
     road_follower and traffic_dodger, so what you tune here stays true on the
     printed robot. See obstacle_rover/mini_car/hardware/BOM.md.

       chassis   160 x 110 x 30 mm   printed PLA
       motors    2x N20 6V 200 RPM
       wheels    60 mm dia x 12 mm
       all-up    ~0.45 kg

     TWO DIFFERENCES FROM THE ROAD CARS, both because a maze is not a road.

     1. THE LIDAR IS 360 DEGREES, not 270. A road car never needs to look
        behind itself - the road only goes one way and reversing is a failure
        mode. A maze car does, twice over: the wall follower's rule is stated
        in terms of the wall on its LEFT and the option of turning BACK, and
        the discovery mapper wants every wall of the cell it is standing in
        marked in one scan rather than after a three-point turn. 180 rays over
        360 degrees is 2 degrees per ray, which at the 0.68 m far wall of a
        cell is a 24 mm sample spacing - fine enough to tell a 60 mm wall from
        a gap.

     2. THERE IS NO DEPTH CAMERA. The other projects carry one to catch
        obstacles below the 70 mm scan plane. A maze wall is 350 mm tall and
        there is nothing else in the world, so a depth camera here would be a
        sensor no node subscribes to - 20 g of mass and a point cloud per
        frame, bought for nothing. If you later add low obstacles to the
        corridors, take depth_guard.py from traffic_dodger; it drops straight
        in. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="maze_car">

  <xacro:property name="base_len"  value="0.160"/>
  <xacro:property name="base_wid"  value="0.110"/>
  <xacro:property name="base_hgt"  value="0.030"/>
  <xacro:property name="wheel_rad" value="0.030"/>
  <xacro:property name="wheel_wid" value="0.012"/>
  <xacro:property name="wheel_sep" value="0.128"/>
  <xacro:property name="caster_rad" value="0.005"/>
  <!-- wheel axle sits this far below base_link centre. base_footprint and the
       caster are both derived from it - keep them derived, never hardcoded. -->
  <xacro:property name="wheel_dz"   value="-0.010"/>
  <xacro:property name="base_z"     value="${wheel_rad - wheel_dz}"/>
  <xacro:property name="lidar_height" value="0.070"/>

  <material name="blue"><color rgba="0.20 0.42 0.90 1"/></material>
  <material name="dark"><color rgba="0.13 0.13 0.15 1"/></material>
  <material name="red"><color rgba="0.90 0.22 0.20 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_rad - wheel_dz}"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_len} ${base_wid} ${base_hgt}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${base_len} ${base_wid} ${base_hgt}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.40"/>
      <inertia ixx="4.33e-4" ixy="0" ixz="0" iyy="8.83e-4" iyz="0" izz="1.26e-3"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_rad}" length="${wheel_wid}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_rad}" length="${wheel_wid}"/></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <inertial>
        <origin rpy="1.5708 0 0"/>
        <mass value="0.025"/>
        <inertia ixx="5.93e-6" ixy="0" ixz="0" iyy="5.93e-6" iyz="0" izz="1.13e-5"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="0.030 ${y} ${wheel_dz}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left"  y="${ wheel_sep/2}"/>
  <xacro:wheel name="right" y="${-wheel_sep/2}"/>

  <link name="caster">
    <visual><geometry><sphere radius="${caster_rad}"/></geometry><material name="dark"/></visual>
    <collision>
      <geometry><sphere radius="${caster_rad}"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="5e-7" ixy="0" ixz="0" iyy="5e-7" iyz="0" izz="5e-7"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster"/>
    <!-- The caster bottom must sit EXACTLY level with the wheel bottoms
         (-0.040 below base_link). A 10 mm error here tilted the chassis 5 deg
         nose-up in obstacle_rover, which tilted the lidar, which made it
         report walls on empty floor. In a 0.62 m corridor that is fatal. -->
    <origin xyz="-0.058 0 ${wheel_dz - wheel_rad + caster_rad}"/>
  </joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.024" length="0.030"/></geometry><material name="red"/></visual>
    <collision><geometry><cylinder radius="0.024" length="0.030"/></geometry></collision>
    <inertial>
      <mass value="0.060"/>
      <inertia ixx="2.64e-5" ixy="0" ixz="0" iyy="2.64e-5" iyz="0" izz="3.68e-5"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- Centred over the wheel axle, not nose-mounted. On a 360 degree scan a
         nose mount puts the rotation centre 40 mm ahead of the turning centre,
         so every spin sweeps the whole scan sideways and the mapper has to
         undo it. Over the axle, a spin in place changes only the bearing. -->
    <origin xyz="0.030 0 ${lidar_height - base_z}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <!-- a full turn, open at one end so the first and last ray are not
                 the same ray counted twice -->
            <min_angle>-3.14159</min_angle>
            <max_angle>3.10743</max_angle>
          </horizontal>
        </scan>
        <!-- 6 m is far more than a corridor needs, and that is the point in
             discovery mode: a long sight line down a straight run maps a dozen
             cells from one scan. min 0.06 clears the chassis. -->
        <range><min>0.06</min><max>6.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.008</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_rad}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.5</max_linear_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- Ground-truth pose on its own topic.

         /odom above is WHEEL odometry and it drifts - traffic_dodger measured
         0.785 m of error after 10 m of driving, which invalidated every score
         it had produced. A maze is far less forgiving: 0.785 m is more than a
         whole cell, so a drifting pose would put the planner in the wrong cell
         entirely and it would follow a path that does not start where the car
         is.

         The obvious ground-truth source, /world/maze/dynamic_pose/info, cannot
         be bridged usefully: ros_gz_bridge maps gz.msgs.Pose_V to TFMessage by
         header frame id rather than the per-pose `name`, so every
         child_frame_id arrives empty and models cannot be told apart. A
         per-model OdometryPublisher sidesteps that - the topic IS the identity.

         Ground truth is the honest choice HERE because this project is about
         search, not about localisation. Everything the car does not know is
         withheld deliberately (discovery mode hides the walls); nothing is
         withheld by accident. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_topic>ego/true_odom</odom_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>
</robot>
